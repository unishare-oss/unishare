# prod: https://your-api-domain.com
API_URL=http://localhost:3001
# prod: https://your-app-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# uniauth origin: central sign-in and account pages (baked in at build time).
NEXT_PUBLIC_UNIAUTH_URL=http://localhost:3002

# Optional: public status page URL (e.g. https://status.example.com). Adds a "Status" link to the landing
# footer; unset hides it. Server-side, read at request time.
STATUS_PAGE_URL=
