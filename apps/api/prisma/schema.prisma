generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id
  name                    String
  email                   String                   @unique
  emailVerified           Boolean                  @default(false)
  image                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  departmentId            String?
  role                    UserRole                 @default(STUDENT)
  banExpires              DateTime?
  banReason               String?
  banned                  Boolean?                 @default(false)
  bio                     String?
  enrollmentYear          Int?
  isAnonymous             Boolean?                 @default(false)
  consentGivenAt          DateTime?
  universityId            String?
  accounts                Account[]
  adminActions            AdminAction[]            @relation("AdminActions")
  chatMessages            ChatMessage[]
  chatParticipants        ChatRoomParticipant[]
  comments                Comment[]
  feedbacks               Feedback[]
  following               Follow[]                 @relation("Followers")
  followers               Follow[]                 @relation("Following")
  notifications           Notification[]
  posts                   Post[]                   @relation("AuthorPosts")
  postRequests            PostRequest[]            @relation("PostRequestAuthor")
  postRequestFulfillments PostRequestFulfillment[]
  postRequestUpvotes      PostRequestUpvote[]
  postViews               PostView[]
  quizzesCreated          Quiz[]                   @relation("QuizzesCreated")
  quizSessions            QuizSession[]            @relation("QuizSessions")
  reactions               Reaction[]
  readingLists            ReadingList[]
  reports                 Report[]                 @relation("ReportsSubmitted")
  rooms                   Room[]
  savedPosts              SavedPost[]
  sessions                Session[]
  studyMaterialsUploaded  StudyMaterial[]          @relation("StudyMaterialsUploaded")
  department              Department?              @relation(fields: [departmentId], references: [id])
  university              University?              @relation(fields: [universityId], references: [id])

  @@map("user")
}

model Department {
  id      String   @id @default(cuid())
  name    String   @unique
  courses Course[]
  users   User[]

  @@map("department")
}

model University {
  id        String  @id @default(cuid())
  name      String  @unique
  shortName String
  logoUrl   String?
  users     User[]

  @@map("university")
}

model Course {
  id             String          @id @default(cuid())
  code           String
  name           String
  departmentId   String
  createdAt      DateTime        @default(now())
  yearLevel      Int?
  department     Department      @relation(fields: [departmentId], references: [id])
  posts          Post[]
  postRequests   PostRequest[]
  quizzes        Quiz[]
  studyMaterials StudyMaterial[]

  @@unique([code, departmentId])
  @@index([departmentId])
  @@map("course")
}

model Post {
  id                  String                   @id @default(cuid())
  type                PostType
  title               String?
  examYear            Int?
  year                Int?
  semester            Int?
  isAnonymous         Boolean?                 @default(false)
  authorId            String
  courseId            String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  deletedAt           DateTime?
  moduleNumber        Int?
  status              PostStatus               @default(APPROVED)
  description         String?
  externalUrl         String?
  shortCode           String                   @unique
  views               Int                      @default(0)
  searchVector        Unsupported("tsvector")?
  publicationStatus   PostPublicationStatus    @default(PUBLISHED)
  trendingScore       Float                    @default(0)
  summarizedAt        DateTime?
  summary             String?
  contentWarning      String?
  comments            Comment[]
  files               File[]
  notifications       Notification[]
  author              User                     @relation("AuthorPosts", fields: [authorId], references: [id])
  course              Course                   @relation(fields: [courseId], references: [id])
  fulfilledRequests   PostRequest[]            @relation("FulfilledRequests")
  requestFulfillments PostRequestFulfillment[]
  tags                PostTag[]
  postViews           PostView[]
  reactions           Reaction[]
  readingListItems    ReadingListPost[]
  reports             Report[]                 @relation("PostReports")
  savedBy             SavedPost[]

  @@index([authorId])
  @@index([courseId])
  @@index([type])
  @@index([status])
  @@index([trendingScore])
  @@index([publicationStatus])
  @@index([createdAt])
  @@index([searchVector], type: Gin)
  @@map("post")
}

model PostView {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("post_view")
}

model Reaction {
  userId String
  postId String
  type   ReactionType
  post   Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("reaction")
}

model File {
  id        String   @id @default(cuid())
  key       String
  name      String
  size      Int
  mimeType  String
  postId    String
  createdAt DateTime @default(now())
  downloads Int      @default(0)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("file")
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  userId    String
  postId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  children  Comment[] @relation("CommentReplies")
  post      Post      @relation(fields: [postId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([postId])
  @@index([parentId])
  @@index([postId, parentId, createdAt])
  @@map("comment")
}

model SavedPost {
  userId  String
  postId  String
  savedAt DateTime @default(now())
  post    Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("saved_post")
}

model ReadingList {
  id          String            @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts       ReadingListPost[]

  @@index([userId])
  @@map("reading_list")
}

model ReadingListPost {
  listId  String
  postId  String
  addedAt DateTime    @default(now())
  list    ReadingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  post    Post        @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([listId, postId])
  @@index([postId])
  @@map("reading_list_post")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  displayName    String?
  isViewOnly     Boolean? @default(false)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  postId    String?
  createdAt DateTime         @default(now())
  requestId String?
  post      Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  request   PostRequest?     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification")
}

model PostRequest {
  id                String                   @id @default(cuid())
  title             String
  description       String?
  courseId          String
  authorId          String
  status            PostRequestStatus        @default(OPEN)
  fulfilledByPostId String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  notifications     Notification[]
  author            User                     @relation("PostRequestAuthor", fields: [authorId], references: [id])
  course            Course                   @relation(fields: [courseId], references: [id])
  fulfilledByPost   Post?                    @relation("FulfilledRequests", fields: [fulfilledByPostId], references: [id])
  suggestions       PostRequestFulfillment[]
  upvotes           PostRequestUpvote[]

  @@index([authorId])
  @@index([courseId])
  @@index([status])
  @@map("post_request")
}

model PostRequestFulfillment {
  id        String      @id @default(cuid())
  requestId String
  postId    String
  userId    String
  createdAt DateTime    @default(now())
  post      Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  request   PostRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@index([requestId])
  @@map("post_request_fulfillment")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follow")
}

model PostRequestUpvote {
  userId    String
  requestId String
  createdAt DateTime    @default(now())
  request   PostRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, requestId])
  @@index([requestId])
  @@map("post_request_upvote")
}

model Room {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String?
  ownerId      String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  snapshot     Bytes?
  visibility   RoomVisibility @default(OPEN)
  passwordHash String?
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("room")
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  color     String    @default("#3B82F6")
  createdAt DateTime  @default(now())
  posts     PostTag[]

  @@index([slug])
  @@map("tag")
}

model PostTag {
  postId    String
  tagId     String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tag")
}

model Report {
  id          String       @id @default(cuid())
  postId      String
  userId      String
  reason      ReportReason
  comment     String?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  adminAction AdminAction?
  post        Post         @relation("PostReports", fields: [postId], references: [id], onDelete: Cascade)
  reporter    User         @relation("ReportsSubmitted", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([status])
  @@index([reason])
  @@index([createdAt])
  @@map("report")
}

model AdminAction {
  id        String   @id @default(cuid())
  reportId  String   @unique
  adminId   String
  action    String
  reason    String?
  createdAt DateTime @default(now())
  admin     User     @relation("AdminActions", fields: [adminId], references: [id])
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("admin_action")
}

model ChatRoom {
  id           String                @id @default(cuid())
  type         ChatRoomType          @default(DM)
  name         String?
  imageUrl     String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  messages     ChatMessage[]
  participants ChatRoomParticipant[]

  @@map("chat_room")
}

model ChatRoomParticipant {
  id         String   @id @default(cuid())
  roomId     String
  userId     String
  lastReadAt DateTime @default(now())
  joinedAt   DateTime @default(now())
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@map("chat_room_participant")
}

model ChatMessage {
  id        String          @id @default(cuid())
  roomId    String
  userId    String?
  type      ChatMessageType @default(TEXT)
  content   String?
  imageUrl  String?
  fileUrl   String?
  fileName  String?
  linkUrl   String?
  parentId  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt    DateTime?
  fileDeleteAt DateTime?
  room         ChatRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    ChatMessage?    @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  children  ChatMessage[]   @relation("MessageReplies")

  @@index([roomId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
  @@index([roomId, parentId, createdAt])
  @@map("chat_message")
}

model Feedback {
  id        String       @id @default(cuid())
  type      FeedbackType
  message   String
  userId    String?
  createdAt DateTime     @default(now())
  user      User?        @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([createdAt])
  @@map("feedback")
}

model StudyMaterial {
  id             String   @id @default(cuid())
  courseId       String
  title          String
  content        String
  uploadedBy     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  fileKey        String?
  quizzes        Quiz[]
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedByUser User     @relation("StudyMaterialsUploaded", fields: [uploadedBy], references: [id])

  @@index([courseId])
  @@index([uploadedBy])
  @@map("study_material")
}

model Quiz {
  id              String         @id @default(cuid())
  courseId        String
  studyMaterialId String?
  title           String
  description     String?
  isPublished     Boolean        @default(false)
  createdBy       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  questionsCount  Int            @default(0)
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdByUser   User           @relation("QuizzesCreated", fields: [createdBy], references: [id])
  studyMaterial   StudyMaterial? @relation(fields: [studyMaterialId], references: [id])
  questions       QuizQuestion[]
  sessions        QuizSession[]

  @@index([courseId])
  @@index([isPublished])
  @@index([createdBy])
  @@map("quiz")
}

model QuizQuestion {
  id               String            @id @default(cuid())
  quizId           String
  content          String
  correctAnswer    Int
  options          String[]
  explanation      String?
  difficulty       String            @default("medium")
  createdAt        DateTime          @default(now())
  questionAttempts QuestionAttempt[]
  quiz             Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_question")
}

model QuizSession {
  id               String            @id @default(cuid())
  quizId           String
  studentId        String
  score            Int               @default(0)
  totalPoints      Int               @default(0)
  attemptedAt      DateTime          @default(now())
  completedAt      DateTime?
  timeSpentSec     Int?
  questionAttempts QuestionAttempt[]
  quiz             Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student          User              @relation("QuizSessions", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([studentId])
  @@index([attemptedAt])
  @@map("quiz_session")
}

model QuestionAttempt {
  id            String       @id @default(cuid())
  sessionId     String
  questionId    String
  studentAnswer Int?
  isCorrect     Boolean?
  timeSpentSec  Int?
  createdAt     DateTime     @default(now())
  question      QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  session       QuizSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
  @@map("question_attempt")
}

enum RoomVisibility {
  OPEN
  VIEW_ONLY
  PRIVATE
}

enum PostRequestStatus {
  OPEN
  FULFILLED
}

enum NotificationType {
  POST_APPROVED
  POST_REJECTED
  COMMENT_ADDED
  REQUEST_SUGGESTION_ADDED
  REQUEST_FULFILLED
  NEW_POST_FROM_FOLLOWED
}

enum UserRole {
  STUDENT
  MODERATOR
  ADMIN
}

enum PostType {
  NOTE
  OLD_QUESTION
  ASSIGNMENT
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReactionType {
  HELPFUL
  LOVE
  FIRE
  WOW
  SALUTE
  FUNNY
}

enum PostPublicationStatus {
  PUBLISHED
  PENDING_REVIEW
  REJECTED
}

enum ReportReason {
  SPAM
  OFFENSIVE
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChatRoomType {
  DM
  GROUP
}

enum ChatMessageType {
  TEXT
  IMAGE
  FILE
  LINK
  SYSTEM
}

enum FeedbackType {
  FEEDBACK
  BUG_REPORT
}
