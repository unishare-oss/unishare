generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id
  name           String
  email          String         @unique
  emailVerified  Boolean        @default(false)
  image          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  departmentId   String?
  role           UserRole       @default(STUDENT)
  banExpires     DateTime?
  banReason      String?
  banned         Boolean?       @default(false)
  bio            String?
  enrollmentYear Int?
  accounts       Account[]
  comments       Comment[]
  notifications  Notification[]
  posts          Post[]         @relation("AuthorPosts")
  postViews      PostView[]
  reactions      Reaction[]
  savedPosts     SavedPost[]
  sessions       Session[]
  department     Department?         @relation(fields: [departmentId], references: [id])
  postRequests   PostRequest[]       @relation("PostRequestAuthor")
  postRequestUpvotes PostRequestUpvote[]

  @@map("user")
}

model Department {
  id      String   @id @default(cuid())
  name    String   @unique
  courses Course[]
  users   User[]

  @@map("department")
}

model Course {
  id           String     @id @default(cuid())
  code         String
  name         String
  departmentId String
  yearLevel    Int?
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id])
  posts        Post[]
  postRequests PostRequest[]

  @@unique([code, departmentId])
  @@index([departmentId])
  @@map("course")
}

model Post {
  id            String         @id @default(cuid())
  type          PostType
  title         String?
  examYear      Int?
  year          Int?
  semester      Int?
  isAnonymous   Boolean?       @default(false)
  authorId      String
  courseId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  moduleNumber  Int?
  status        PostStatus     @default(APPROVED)
  description   String?
  externalUrl   String?
  shortCode     String         @unique
  views         Int            @default(0)
  comments      Comment[]
  files         File[]
  notifications Notification[]
  author        User           @relation("AuthorPosts", fields: [authorId], references: [id])
  course        Course         @relation(fields: [courseId], references: [id])
  postViews     PostView[]
  reactions     Reaction[]
  savedBy       SavedPost[]
  fulfilledRequests PostRequest[] @relation("FulfilledRequests")

  @@index([authorId])
  @@index([courseId])
  @@index([type])
  @@index([status])
  @@map("post")
}

model PostView {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("post_view")
}

model Reaction {
  userId String
  postId String
  type   ReactionType
  post   Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("reaction")
}

model File {
  id        String   @id @default(cuid())
  key       String
  name      String
  size      Int
  mimeType  String
  postId    String
  createdAt DateTime @default(now())
  downloads Int      @default(0)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("file")
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  userId    String
  postId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  post      Post      @relation(fields: [postId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([postId])
  @@map("comment")
}

model SavedPost {
  userId  String
  postId  String
  savedAt DateTime @default(now())
  post    Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("saved_post")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  postId    String?
  createdAt DateTime         @default(now())
  post      Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification")
}

model PostRequest {
  id                String              @id @default(cuid())
  title             String
  description       String?
  courseId          String
  authorId          String
  status            PostRequestStatus   @default(OPEN)
  fulfilledByPostId String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  author            User                @relation("PostRequestAuthor", fields: [authorId], references: [id])
  course            Course              @relation(fields: [courseId], references: [id])
  fulfilledByPost   Post?               @relation("FulfilledRequests", fields: [fulfilledByPostId], references: [id])
  upvotes           PostRequestUpvote[]

  @@index([authorId])
  @@index([courseId])
  @@index([status])
  @@map("post_request")
}

model PostRequestUpvote {
  userId    String
  requestId String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  request   PostRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@id([userId, requestId])
  @@index([requestId])
  @@map("post_request_upvote")
}

enum PostRequestStatus {
  OPEN
  FULFILLED
}

enum NotificationType {
  POST_APPROVED
  POST_REJECTED
  COMMENT_ADDED
}

enum UserRole {
  STUDENT
  MODERATOR
  ADMIN
}

enum PostType {
  NOTE
  OLD_QUESTION
  ASSIGNMENT
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReactionType {
  HELPFUL
  LOVE
  FIRE
  WOW
  SALUTE
  FUNNY
}
