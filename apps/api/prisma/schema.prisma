generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id
  name                    String
  email                   String                   @unique
  emailVerified           Boolean                  @default(false)
  image                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  departmentId            String?
  role                    UserRole                 @default(STUDENT)
  banExpires              DateTime?
  banReason               String?
  banned                  Boolean?                 @default(false)
  isAnonymous             Boolean?                 @default(false)
  bio                     String?
  enrollmentYear          Int?
  accounts                Account[]
  comments                Comment[]
  notifications           Notification[]
  posts                   Post[]                   @relation("AuthorPosts")
  postViews               PostView[]
  reactions               Reaction[]
  savedPosts              SavedPost[]
  sessions                Session[]
  department              Department?              @relation(fields: [departmentId], references: [id])
  postRequests            PostRequest[]            @relation("PostRequestAuthor")
  postRequestUpvotes      PostRequestUpvote[]
  postRequestFulfillments PostRequestFulfillment[]
  followers               Follow[]                 @relation("Following")
  following               Follow[]                 @relation("Followers")
  reports                 Report[]                 @relation("ReportsSubmitted")
  adminActions            AdminAction[]            @relation("AdminActions")
  rooms                   Room[]

  @@map("user")
}

model Department {
  id      String   @id @default(cuid())
  name    String   @unique
  courses Course[]
  users   User[]

  @@map("department")
}

model Course {
  id           String        @id @default(cuid())
  code         String
  name         String
  departmentId String
  yearLevel    Int?
  createdAt    DateTime      @default(now())
  department   Department    @relation(fields: [departmentId], references: [id])
  posts        Post[]
  postRequests PostRequest[]

  @@unique([code, departmentId])
  @@index([departmentId])
  @@map("course")
}

model Post {
  id                  String                   @id @default(cuid())
  type                PostType
  title               String?
  examYear            Int?
  year                Int?
  semester            Int?
  isAnonymous         Boolean?                 @default(false)
  authorId            String
  courseId            String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  deletedAt           DateTime?
  moduleNumber        Int?
  status              PostStatus               @default(APPROVED)
  description         String?
  externalUrl         String?
  shortCode           String                   @unique
  views               Int                      @default(0)
  searchVector        Unsupported("tsvector")?
  trendingScore       Float                    @default(0)
  publicationStatus   PostPublicationStatus    @default(PUBLISHED)
  comments            Comment[]
  files               File[]
  notifications       Notification[]
  author              User                     @relation("AuthorPosts", fields: [authorId], references: [id])
  course              Course                   @relation(fields: [courseId], references: [id])
  postViews           PostView[]
  reactions           Reaction[]
  savedBy             SavedPost[]
  tags                PostTag[]
  fulfilledRequests   PostRequest[]            @relation("FulfilledRequests")
  requestFulfillments PostRequestFulfillment[]
  reports             Report[]                 @relation("PostReports")

  @@index([authorId])
  @@index([courseId])
  @@index([type])
  @@index([status])
  @@index([trendingScore])
  @@index([publicationStatus])
  @@index([createdAt])
  @@map("post")
}

model PostView {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("post_view")
}

model Reaction {
  userId String
  postId String
  type   ReactionType
  post   Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("reaction")
}

model File {
  id        String   @id @default(cuid())
  key       String
  name      String
  size      Int
  mimeType  String
  postId    String
  createdAt DateTime @default(now())
  downloads Int      @default(0)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("file")
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  userId    String
  postId    String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  post      Post      @relation(fields: [postId], references: [id])
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  children  Comment[] @relation("CommentReplies")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([postId])
  @@index([parentId])
  @@index([postId, parentId, createdAt])
  @@map("comment")
}

model SavedPost {
  userId  String
  postId  String
  savedAt DateTime @default(now())
  post    Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("saved_post")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  displayName    String?
  isViewOnly     Boolean? @default(false)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  postId    String?
  requestId String?
  createdAt DateTime         @default(now())
  post      Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  request   PostRequest?     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification")
}

model PostRequest {
  id                String                   @id @default(cuid())
  title             String
  description       String?
  courseId          String
  authorId          String
  status            PostRequestStatus        @default(OPEN)
  fulfilledByPostId String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  author            User                     @relation("PostRequestAuthor", fields: [authorId], references: [id])
  course            Course                   @relation(fields: [courseId], references: [id])
  fulfilledByPost   Post?                    @relation("FulfilledRequests", fields: [fulfilledByPostId], references: [id])
  upvotes           PostRequestUpvote[]
  suggestions       PostRequestFulfillment[]
  notifications     Notification[]

  @@index([authorId])
  @@index([courseId])
  @@index([status])
  @@map("post_request")
}

model PostRequestFulfillment {
  id        String      @id @default(cuid())
  requestId String
  postId    String
  userId    String
  createdAt DateTime    @default(now())
  request   PostRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  post      Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@index([requestId])
  @@map("post_request_fulfillment")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follow")
}

model PostRequestUpvote {
  userId    String
  requestId String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  request   PostRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@id([userId, requestId])
  @@index([requestId])
  @@map("post_request_upvote")
}

model Room {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  snapshot              Bytes?
  isGuestEditingAllowed Boolean  @default(true)
  owner                 User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("room")
}

enum PostRequestStatus {
  OPEN
  FULFILLED
}

enum NotificationType {
  POST_APPROVED
  POST_REJECTED
  COMMENT_ADDED
  REQUEST_SUGGESTION_ADDED
  REQUEST_FULFILLED
  NEW_POST_FROM_FOLLOWED
}

enum UserRole {
  STUDENT
  MODERATOR
  ADMIN
}

enum PostType {
  NOTE
  OLD_QUESTION
  ASSIGNMENT
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReactionType {
  HELPFUL
  LOVE
  FIRE
  WOW
  SALUTE
  FUNNY
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  color     String    @default("#3B82F6")
  createdAt DateTime  @default(now())
  posts     PostTag[]

  @@index([slug])
  @@map("tag")
}

model PostTag {
  postId    String
  tagId     String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tag")
}

enum PostPublicationStatus {
  PUBLISHED
  PENDING_REVIEW // Soft-deleted: reported, pending admin review
  REJECTED // Permanently deleted: admin rejected report
}

enum ReportReason {
  SPAM // Duplicate, off-topic
  OFFENSIVE // Inappropriate language
  COPYRIGHT // IP violation
  OTHER // Policy violation
}

enum ReportStatus {
  PENDING // Awaiting admin review
  APPROVED // Admin approved report
  REJECTED // Admin rejected report (post remains published)
}

model Report {
  id        String       @id @default(cuid())
  postId    String
  userId    String // Reporter
  reason    ReportReason
  comment   String?      @db.Text
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  post     Post @relation("PostReports", fields: [postId], references: [id], onDelete: Cascade)
  reporter User @relation("ReportsSubmitted", fields: [userId], references: [id], onDelete: Cascade)

  adminAction AdminAction?

  @@unique([postId, userId]) // One report per user per post
  @@index([status])
  @@index([reason])
  @@index([createdAt])
  @@map("report")
}

model AdminAction {
  id        String   @id @default(cuid())
  reportId  String   @unique
  adminId   String
  action    String // 'approve', 'reject'
  reason    String?  @db.Text
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  admin  User   @relation("AdminActions", fields: [adminId], references: [id])

  @@index([createdAt])
  @@map("admin_action")
}
