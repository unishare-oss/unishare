generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id
  name                    String
  email                   String                   @unique
  emailVerified           Boolean                  @default(false)
  image                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  departmentId            String?
  role                    UserRole                 @default(STUDENT)
  banExpires              DateTime?
  banReason               String?
  banned                  Boolean?                 @default(false)
  bio                     String?
  enrollmentYear          Int?
  isAnonymous             Boolean?                 @default(false)
  consentGivenAt          DateTime?
  universityId            String?
  publicKey               String?
  /// Passphrase-encrypted private key backup (PBKDF2 + AES-GCM blob, opaque to the server)
  keyBackup               String?
  accounts                Account[]
  adminActions            AdminAction[]            @relation("AdminActions")
  chatMessages            ChatMessage[]
  chatParticipants        ChatRoomParticipant[]
  comments                Comment[]
  examsCreated            Exam[]                   @relation("ExamsCreated")
  feedbacks               Feedback[]
  following               Follow[]                 @relation("Followers")
  followers               Follow[]                 @relation("Following")
  notifications           Notification[]
  posts                   Post[]                   @relation("AuthorPosts")
  postRequests            PostRequest[]            @relation("PostRequestAuthor")
  postRequestFulfillments PostRequestFulfillment[]
  postRequestUpvotes      PostRequestUpvote[]
  postViews               PostView[]
  decksCreated            Deck[]                   @relation("DecksCreated")
  quizzesCreated          Quiz[]                   @relation("QuizzesCreated")
  quizSessions            QuizSession[]            @relation("QuizSessions")
  reactions               Reaction[]
  readingLists            ReadingList[]
  reports                 Report[]                 @relation("ReportsSubmitted")
  rooms                   Room[]
  savedPosts              SavedPost[]
  sessions                Session[]
  studyMaterialsUploaded  StudyMaterial[]          @relation("StudyMaterialsUploaded")
  department              Department?              @relation(fields: [departmentId], references: [id])
  university              University?              @relation(fields: [universityId], references: [id])
  oauthApplications       OauthApplication[]
  oauthAccessTokens       OauthAccessToken[]
  oauthConsents           OauthConsent[]

  @@map("user")
}

model Department {
  id      String   @id @default(cuid())
  name    String   @unique
  courses Course[]
  users   User[]

  @@map("department")
}

model University {
  id        String  @id @default(cuid())
  name      String  @unique
  shortName String
  logoUrl   String?
  users     User[]

  @@map("university")
}

model Course {
  id             String                @id @default(cuid())
  code           String
  name           String
  departmentId   String
  createdAt      DateTime              @default(now())
  yearLevel      Int?
  department     Department            @relation(fields: [departmentId], references: [id])
  moduleOutlines CourseModuleOutline[]
  exams          Exam[]
  posts          Post[]
  postRequests   PostRequest[]
  quizzes        Quiz[]
  studyMaterials StudyMaterial[]

  @@unique([code, departmentId])
  @@index([departmentId])
  @@map("course")
}

model CourseModuleOutline {
  id           String   @id @default(cuid())
  courseId     String
  moduleNumber Int
  topics       String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, moduleNumber])
  @@map("course_module_outline")
}

model Exam {
  id             String         @id @default(cuid())
  courseId       String
  title          String
  examRoom       String?
  notes          String?
  startsAt       DateTime
  endsAt         DateTime?
  createdBy      String
  reminderSentAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdByUser  User           @relation("ExamsCreated", fields: [createdBy], references: [id])
  notifications  Notification[]

  @@index([courseId])
  @@index([startsAt])
  @@map("exam")
}

model Post {
  id                  String                   @id @default(cuid())
  type                PostType
  title               String?
  examYear            Int?
  year                Int?
  semester            Int?
  isAnonymous         Boolean?                 @default(false)
  authorId            String
  courseId            String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  deletedAt           DateTime?
  moduleNumber        Int?
  status              PostStatus               @default(APPROVED)
  description         String?
  externalUrl         String?
  shortCode           String                   @unique
  views               Int                      @default(0)
  searchVector        Unsupported("tsvector")?
  publicationStatus   PostPublicationStatus    @default(PUBLISHED)
  trendingScore       Float                    @default(0)
  summarizedAt        DateTime?
  summary             String?
  contentWarning      String?
  comments            Comment[]
  files               File[]
  notifications       Notification[]
  author              User                     @relation("AuthorPosts", fields: [authorId], references: [id])
  chunks              PostChunk[]
  course              Course                   @relation(fields: [courseId], references: [id])
  fulfilledRequests   PostRequest[]            @relation("FulfilledRequests")
  decks               Deck[]
  requestFulfillments PostRequestFulfillment[]
  tags                PostTag[]
  postViews           PostView[]
  reactions           Reaction[]
  readingListItems    ReadingListPost[]
  reports             Report[]                 @relation("PostReports")
  savedBy             SavedPost[]

  @@index([authorId])
  @@index([courseId])
  @@index([type])
  @@index([status])
  @@index([trendingScore])
  @@index([publicationStatus])
  @@index([createdAt])
  @@index([searchVector], type: Gin)
  @@map("post")
}

model PostView {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("post_view")
}

model Reaction {
  userId String
  postId String
  type   ReactionType
  post   Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("reaction")
}

model File {
  id              String       @id @default(cuid())
  key             String
  name            String
  size            Int
  mimeType        String
  postId          String
  createdAt       DateTime     @default(now())
  downloads       Int          @default(0)
  ingestStatus    IngestStatus @default(PENDING)
  ingestError     String?
  ingestStartedAt DateTime?
  ingestedAt      DateTime?
  post            Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  chunks          PostChunk[]

  @@index([postId])
  @@map("file")
}

model PostChunk {
  id         String                      @id @default(cuid())
  postId     String
  fileId     String
  chunkIndex Int
  content    String
  pageNum    Int?
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                    @default(now())
  file       File                        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  post       Post                        @relation(fields: [postId], references: [id], onDelete: Cascade)

  // `post_chunk_embedding_idx` — the HNSW index on `embedding` — exists in the database but
  // CANNOT be represented here: Prisma models neither the `vector` type nor `USING hnsw`. It is
  // created in raw SQL by 20260729000000_add_post_chunk_vectors.
  //
  // Consequence: `prisma migrate dev` diffs this schema against the database, sees an index it
  // has no source for, and generates `DROP INDEX "post_chunk_embedding_idx"`. That has already
  // happened once. DELETE any such migration — do not apply or commit it. Dropping the index
  // does not break correctness, so nothing would fail loudly; retrieval would just fall back to
  // sequential scans and quietly get slower as the corpus grows.
  //
  // migrations.spec.ts fails the build if such a migration is ever committed.

  @@unique([fileId, chunkIndex])
  @@index([postId])
  @@map("post_chunk")
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  userId    String
  postId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  children  Comment[] @relation("CommentReplies")
  post      Post      @relation(fields: [postId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([postId])
  @@index([parentId])
  @@index([postId, parentId, createdAt])
  @@map("comment")
}

model SavedPost {
  userId  String
  postId  String
  savedAt DateTime @default(now())
  post    Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("saved_post")
}

model ReadingList {
  id          String            @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts       ReadingListPost[]

  @@index([userId])
  @@map("reading_list")
}

model ReadingListPost {
  listId  String
  postId  String
  addedAt DateTime    @default(now())
  list    ReadingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  post    Post        @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([listId, postId])
  @@index([postId])
  @@map("reading_list_post")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  displayName    String?
  isViewOnly     Boolean? @default(false)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model OauthApplication {
  id           String             @id
  name         String
  icon         String?
  metadata     String?
  clientId     String             @unique
  clientSecret String?
  redirectUrls String
  type         String
  disabled     Boolean?           @default(false)
  userId       String?
  createdAt    DateTime
  updatedAt    DateTime
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens OauthAccessToken[]
  consents     OauthConsent[]

  @@index([userId])
  @@map("oauth_application")
}

model OauthAccessToken {
  id                    String           @id
  accessToken           String           @unique
  refreshToken          String           @unique
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  clientId              String
  userId                String?
  scopes                String
  createdAt             DateTime
  updatedAt             DateTime
  client                OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user                  User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id           String           @id
  clientId     String
  userId       String
  scopes       String
  createdAt    DateTime
  updatedAt    DateTime
  consentGiven Boolean
  client       OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  message    String
  read       Boolean          @default(false)
  postId     String?
  createdAt  DateTime         @default(now())
  requestId  String?
  chatRoomId String?
  examId     String?
  post       Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  request    PostRequest?     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  chatRoom   ChatRoom?        @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  exam       Exam?            @relation(fields: [examId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification")
}

model PostRequest {
  id                String                   @id @default(cuid())
  title             String
  description       String?
  courseId          String
  authorId          String
  status            PostRequestStatus        @default(OPEN)
  fulfilledByPostId String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  notifications     Notification[]
  author            User                     @relation("PostRequestAuthor", fields: [authorId], references: [id])
  course            Course                   @relation(fields: [courseId], references: [id])
  fulfilledByPost   Post?                    @relation("FulfilledRequests", fields: [fulfilledByPostId], references: [id])
  suggestions       PostRequestFulfillment[]
  upvotes           PostRequestUpvote[]

  @@index([authorId])
  @@index([courseId])
  @@index([status])
  @@map("post_request")
}

model PostRequestFulfillment {
  id        String      @id @default(cuid())
  requestId String
  postId    String
  userId    String
  createdAt DateTime    @default(now())
  post      Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  request   PostRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@index([requestId])
  @@map("post_request_fulfillment")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follow")
}

model PostRequestUpvote {
  userId    String
  requestId String
  createdAt DateTime    @default(now())
  request   PostRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, requestId])
  @@index([requestId])
  @@map("post_request_upvote")
}

model Room {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String?
  ownerId      String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  snapshot     Bytes?
  visibility   RoomVisibility @default(OPEN)
  passwordHash String?
  encrypted    Boolean        @default(false)
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("room")
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  color     String    @default("#3B82F6")
  createdAt DateTime  @default(now())
  posts     PostTag[]

  @@index([slug])
  @@map("tag")
}

model PostTag {
  postId    String
  tagId     String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tag")
}

model Report {
  id          String       @id @default(cuid())
  postId      String
  userId      String
  reason      ReportReason
  comment     String?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  adminAction AdminAction?
  post        Post         @relation("PostReports", fields: [postId], references: [id], onDelete: Cascade)
  reporter    User         @relation("ReportsSubmitted", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([status])
  @@index([reason])
  @@index([createdAt])
  @@map("report")
}

model AdminAction {
  id        String   @id @default(cuid())
  reportId  String   @unique
  adminId   String
  action    String
  reason    String?
  createdAt DateTime @default(now())
  admin     User     @relation("AdminActions", fields: [adminId], references: [id])
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("admin_action")
}

model ChatRoom {
  id            String                @id @default(cuid())
  type          ChatRoomType          @default(DM)
  name          String?
  imageUrl      String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  messages      ChatMessage[]
  notifications Notification[]
  participants  ChatRoomParticipant[]

  @@map("chat_room")
}

model ChatRoomParticipant {
  id               String   @id @default(cuid())
  roomId           String
  userId           String
  lastReadAt       DateTime @default(now())
  joinedAt         DateTime @default(now())
  encryptedRoomKey String?
  room             ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@map("chat_room_participant")
}

model ChatMessage {
  id           String          @id @default(cuid())
  roomId       String
  userId       String?
  type         ChatMessageType @default(TEXT)
  content      String?
  imageUrl     String?
  linkUrl      String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  parentId     String?
  deletedAt    DateTime?
  fileName     String?
  fileUrl      String?
  fileDeleteAt DateTime?
  parent       ChatMessage?    @relation("MessageReplies", fields: [parentId], references: [id])
  children     ChatMessage[]   @relation("MessageReplies")
  room         ChatRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
  @@index([roomId, parentId, createdAt])
  @@map("chat_message")
}

model Feedback {
  id        String       @id @default(cuid())
  type      FeedbackType
  message   String
  userId    String?
  createdAt DateTime     @default(now())
  user      User?        @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([createdAt])
  @@map("feedback")
}

model StudyMaterial {
  id             String   @id @default(cuid())
  courseId       String
  title          String
  content        String
  uploadedBy     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  fileKey        String?
  quizzes        Quiz[]
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedByUser User     @relation("StudyMaterialsUploaded", fields: [uploadedBy], references: [id])

  @@index([courseId])
  @@index([uploadedBy])
  @@map("study_material")
}

model Quiz {
  id              String         @id @default(cuid())
  courseId        String
  studyMaterialId String?
  moduleNumber    Int?
  title           String
  description     String?
  isPublished     Boolean        @default(false)
  createdBy       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  questionsCount  Int            @default(0)
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdByUser   User           @relation("QuizzesCreated", fields: [createdBy], references: [id])
  studyMaterial   StudyMaterial? @relation(fields: [studyMaterialId], references: [id])
  questions       QuizQuestion[]
  sessions        QuizSession[]

  @@index([courseId])
  @@index([isPublished])
  @@index([createdBy])
  @@map("quiz")
}

model QuizQuestion {
  id               String            @id @default(cuid())
  quizId           String
  content          String
  correctAnswer    Int
  options          String[]
  explanation      String?
  difficulty       String            @default("medium")
  createdAt        DateTime          @default(now())
  questionAttempts QuestionAttempt[]
  quiz             Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_question")
}

model QuizSession {
  id               String            @id @default(cuid())
  quizId           String
  studentId        String
  score            Int               @default(0)
  totalPoints      Int               @default(0)
  attemptedAt      DateTime          @default(now())
  completedAt      DateTime?
  timeSpentSec     Int?
  questionAttempts QuestionAttempt[]
  quiz             Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student          User              @relation("QuizSessions", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([studentId])
  @@index([attemptedAt])
  @@map("quiz_session")
}

model QuestionAttempt {
  id            String       @id @default(cuid())
  sessionId     String
  questionId    String
  studentAnswer Int?
  isCorrect     Boolean?
  timeSpentSec  Int?
  createdAt     DateTime     @default(now())
  question      QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  session       QuizSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
  @@map("question_attempt")
}

/// A slide deck generated from a free-form prompt by the external deck service.
///
/// `sourcePostId` is nullable on purpose: decks are free-form today, but grounding one in an
/// existing post is the same row with the field set — no migration when that lands.
///
/// `jobId` is the queue job id, kept so a waiting deck can report how many are ahead of it.
/// It is NOT a foreign key to anything: the queue is Redis, jobs are evicted once complete,
/// and a null here simply means the deck is no longer waiting.
model Deck {
  id                     String     @id @default(cuid())
  ownerId                String
  prompt                 String
  title                  String?
  slideCount             Int
  language               String     @default("English")
  template               String     @default("general")
  sourcePostId           String?
  status                 DeckStatus @default(QUEUED)
  error                  String?
  jobId                  String?
  /// The generator's own presentation id. Required to edit or re-export an existing deck —
  /// every edit endpoint is keyed on it, so discarding it would make decks write-once.
  externalId             String?
  /// Generation options, kept so "tweak and regenerate" and the editor can reopen a deck
  /// with the settings it was made under rather than defaults.
  tone                   String     @default("default")
  verbosity              String     @default("standard")
  instructions           String?
  includeTitleSlide      Boolean    @default(true)
  includeTableOfContents Boolean    @default(false)
  webSearch              Boolean    @default(false)
  /// Object-store keys in the same bucket as every other file, under a decks/ prefix.
  /// The PDF is a re-render of the same deck, not a second generation, and exists so the
  /// deck can be previewed in-app without downloading it.
  key                    String?
  pdfKey                 String?
  sizeBytes              Int?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  startedAt              DateTime?
  completedAt            DateTime?
  owner                  User       @relation("DecksCreated", fields: [ownerId], references: [id], onDelete: Cascade)
  sourcePost             Post?      @relation(fields: [sourcePostId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([status])
  @@map("deck")
}

enum DeckStatus {
  QUEUED
  GENERATING
  READY
  FAILED
}

enum RoomVisibility {
  OPEN
  VIEW_ONLY
  PRIVATE
}

enum IngestStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  UNSUPPORTED
}

enum PostRequestStatus {
  OPEN
  FULFILLED
}

