{
  "extends": "@unishare/tsconfig/nestjs.json",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "rootDir": "src",
    "types": ["multer", "jest", "node"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}
