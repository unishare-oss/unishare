# -----------------------------------------------------------------------
# REQUIRED in production (server will throw at startup if any are missing)
# -----------------------------------------------------------------------

DATABASE_URL=postgresql://postgres:password@localhost:5432/unishare
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3001 # prod: the WEB origin (https://share.psstee.dev); it proxies /api here
FRONTEND_URL=http://localhost:3000    # prod: https://your-frontend-domain.com
MCP_ENABLED=false                     # set true to expose MCP resource metadata and /mcp
UNIAUTH_ISSUER=http://localhost:3002/api/auth # sign-in happens on uniauth (OIDC)
UNIAUTH_CLIENT_ID=                    # from uniauth's scripts/create-client.ts
UNIAUTH_CLIENT_SECRET=
MCP_AUTH_ISSUER=                      # defaults to UNIAUTH_ISSUER
UNIAUTH_ORG_KMUTT=                    # uniauth organization id the seed links to KMUTT (differs per environment)
UNIAUTH_ORG_MFU=                      # same for MFU; leave empty until the organization exists in uniauth
UNIAUTH_DIRECTORY_CLIENT_ID=           # machine client for uniauth's directory + v1 identity events (set both or neither)
UNIAUTH_DIRECTORY_CLIENT_SECRET=
# UNIAUTH_EVENTS_EXTRA_AUDIENCES=     # the old machine client id, only while a credential rotation overlaps
# UNIAUTH_RECONCILE_HOURS=6           # how often to catch up with uniauth's change feed

# -----------------------------------------------------------------------
# OPTIONAL — S3-compatible storage (Cloudflare R2, MinIO, AWS S3, etc.)
# -----------------------------------------------------------------------

S3_ENDPOINT=https:// <account >.r2.cloudflarestorage.com

# OPTIONAL. Where the SERVER talks to storage, when that differs from the
# browser-facing endpoint above. Presigned URLs are signed for a specific host,
# so S3_ENDPOINT must stay browser-reachable -- but head/delete/multipart calls
# are server-to-server and gain nothing from leaving your network.
#
# Self-hosting storage beside the app? Set this to the internal address and those
# calls take the direct route instead of going out to the internet and back:
#   S3_INTERNAL_ENDPOINT=http://garage.garage.svc.cluster.local:3900   # k8s
#   S3_INTERNAL_ENDPOINT=http://garage:3900                            # compose
# Leave unset for managed storage (R2, S3) -- there is no internal route to use.
# S3_INTERNAL_ENDPOINT=
S3_REGION=auto
S3_BUCKET=unishare
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=https://your-public-bucket-url.com

# -----------------------------------------------------------------------
# Used by CacheModule for response caching and rate-limit state.
# Falls back to in-memory if unset, but Redis is strongly recommended
# for multi-instance / production deployments.
# -----------------------------------------------------------------------

REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------
# OPTIONAL — misc
# -----------------------------------------------------------------------

# Month (1-12) when the academic year starts. Default: 8 (August)
ACADEMIC_START_MONTH=8

PORT=3001

# -----------------------------------------------------------------------
# OPTIONAL — AI post summarization
# Automatically generates a 2-3 sentence summary when a post is approved.
# Leave AI_SUMMARY_PROVIDER unset (or empty) to disable.
#
# Provider options:
#
#   groq   — Fast, free tier available (14,400 req/day)
#            Get API key: https://console.groq.com → API Keys
#            Recommended model: openai/gpt-oss-120b
#
#   gemini — Google Generative AI, free tier (1,500 req/day on Flash)
#            Get API key: https://aistudio.google.com/app/apikey
#            Recommended model: gemini-2.5-flash
#
#   ollama — Self-hosted, no API key needed, requires a running Ollama instance
#            Install: https://ollama.com/download
#            Then: ollama pull llama3.2
#            Recommended model: llama3.2
# -----------------------------------------------------------------------

# Provider: groq | gemini | ollama  (leave empty to disable)
AI_SUMMARY_PROVIDER=

# API key — required for groq and gemini; not used for ollama
AI_SUMMARY_API_KEY=

# Model name (provider-specific defaults used if unset)
#   groq:   openai/gpt-oss-120b
#   gemini: gemini-2.5-flash
#   ollama: llama3.2
AI_SUMMARY_MODEL=

# Ollama only: base URL of your Ollama instance
AI_SUMMARY_ENDPOINT=http://localhost:11434

# Optional tracing. Leave the endpoint unset for local runs without a collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=unishare-api
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_SDK_DISABLED=true
